# Copy to .env.local for overrides, or use .env.development (committed; used by npm run dev).
# Laravel public origin only — no trailing slash, no /api suffix.
REACT_APP_API_BASE=http://127.0.0.1:8000

# Production deploy (Railway etc.): set REACT_APP_API_BASE on the frontend service, or edit
# public/railway-fallback.json and redeploy.
# REACT_APP_API_BASE=https://your-laravel-service.up.railway.app
