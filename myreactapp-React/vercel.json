{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://smart-monitoring-production.up.railway.app/api/:match*"
    },
    {
      "source": "/sanctum/:match*",
      "destination": "https://smart-monitoring-production.up.railway.app/sanctum/:match*"
    },
    {
      "source": "/storage/:match*",
      "destination": "https://smart-monitoring-production.up.railway.app/storage/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}