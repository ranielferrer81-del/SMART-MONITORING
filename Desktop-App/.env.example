# Copy this file to ".env" in the Desktop-App folder (same folder as package.json).
# Vite reads VITE_* at dev/build time — rebuild the app after changing this.
#
# Backend origin only (no trailing slash). Do not add /api — axios uses /api/... paths.
#
# Local Laravel (default):
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# LAN (other PCs on same network — use your PC's IP where Laravel runs):
# VITE_API_BASE_URL=http://192.168.1.5:8000
#
# Cloud / GitHub Release: set public/api-base.json "apiBase" to your public Laravel URL,
# then push a version tag (v1.0.0) — see Desktop-App/GITHUB_RELEASE.md
# VITE_API_BASE_URL=https://your-laravel-service.up.railway.app
